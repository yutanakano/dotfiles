[user]
	name = Your Name
	email = your.email@example.com

[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	autocrlf = input
	quotepath = false

[color]
	ui = auto

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	df = diff
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	last = log -1 HEAD
	unstage = reset HEAD --

[push]
	default = simple

[pull]
	rebase = false

[init]
	defaultBranch = main

[diff]
	tool = vimdiff

[merge]
	tool = vimdiff
	conflictstyle = diff3
