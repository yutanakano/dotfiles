[ghq]
	root = ~/ghq
[user]
	name = YOUR_NAME
	email = YOUR_EMAIL
[color]
	ui = true
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[core]
	editor = nvim
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autoStash = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	colorMoved = default
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	lg = log --oneline --graph --decorate
